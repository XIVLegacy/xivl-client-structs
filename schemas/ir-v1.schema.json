{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XIVLegacy/xivl-client-structs/schemas/ir-v1.schema.json",
  "title": "Client-structure intermediate representation, version 1",
  "description": "Contract for manifests/ir_catalog.json, the normalized BCS-S and BCS-Y catalogs. Generated by tools/build_ir.py and validated by tools/validate_ir.py. Curated values without a source-catalog home live in manifests/ir_overlay.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["irVersion", "gameVersion", "generator", "inputs", "dimensions", "counts", "types", "symbols", "citations", "relationships"],
  "properties": {
    "irVersion": {"const": "1.0"},
    "gameVersion": {"const": "1.23b"},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "generatorVersion", "schema"],
      "properties": {
        "tool": {"const": "tools/build_ir.py"},
        "generatorVersion": {"type": "integer", "minimum": 1},
        "schema": {"const": "schemas/ir-v1.schema.json"}
      }
    },
    "inputs": {
      "description": "Every file the build read, with its content hash. Regenerating from identical inputs must reproduce this document byte for byte.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "dimensions": {
      "description": "Per-dimension population status. A dimension marked deferred or declared-unknown must carry no populated value anywhere in the document; validate_ir.py enforces this.",
      "type": "object",
      "additionalProperties": false,
      "required": ["namespaces", "sizes", "offsets", "unknownSpans", "confidence", "functions", "evidenceRefs", "alignment", "bases", "vtables", "payloadRelationships", "payloadTypeBindings"],
      "properties": {
        "namespaces": {"$ref": "#/$defs/dimensionStatus"},
        "sizes": {"$ref": "#/$defs/dimensionStatus"},
        "offsets": {"$ref": "#/$defs/dimensionStatus"},
        "unknownSpans": {"$ref": "#/$defs/dimensionStatus"},
        "confidence": {"$ref": "#/$defs/dimensionStatus"},
        "functions": {"$ref": "#/$defs/dimensionStatus"},
        "evidenceRefs": {"$ref": "#/$defs/dimensionStatus"},
        "alignment": {"$ref": "#/$defs/dimensionStatus"},
        "bases": {"$ref": "#/$defs/dimensionStatus"},
        "vtables": {"$ref": "#/$defs/dimensionStatus"},
        "payloadRelationships": {"$ref": "#/$defs/dimensionStatus"},
        "payloadTypeBindings": {"$ref": "#/$defs/dimensionStatus"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["types", "symbols", "citations", "members", "unknownSpans", "opcodes"],
      "properties": {
        "types": {"type": "integer", "minimum": 0},
        "symbols": {"type": "integer", "minimum": 0},
        "citations": {"type": "integer", "minimum": 0},
        "members": {"type": "integer", "minimum": 0},
        "unknownSpans": {"type": "integer", "minimum": 0},
        "opcodes": {"type": "integer", "minimum": 0}
      }
    },
    "types": {
      "type": "array",
      "items": {"$ref": "#/$defs/type"}
    },
    "symbols": {
      "type": "array",
      "items": {"$ref": "#/$defs/symbol"}
    },
    "citations": {
      "type": "array",
      "items": {"$ref": "#/$defs/citation"}
    },
    "relationships": {"$ref": "#/$defs/relationships"}
  },
  "$defs": {
    "dimensionStatus": {
      "description": "populated: values are present and authoritative. declared-unknown: the dimension is modeled but no evidence records it, so every value is an explicit unknown. deferred: a named later phase owns it and no value may be present.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "note"],
      "properties": {
        "status": {"enum": ["populated", "declared-unknown", "deferred"]},
        "owner": {"type": "string", "pattern": "^C\\d[a-z]?$"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "bcsYId": {"type": "string", "pattern": "^BCS-Y-\\d{4}$"},
    "bcsSId": {"type": "string", "pattern": "^BCS-S-\\d{4}$"},
    "citationId": {"type": "string", "pattern": "^EV-\\d{4}$"},
    "namespace": {
      "description": "Recorded verbatim. Dotted and C++ '::' conventions are classified, not unified.",
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "convention", "segments"],
      "properties": {
        "raw": {"type": "string", "minLength": 1},
        "convention": {"enum": ["dotted", "cxx", "single"]},
        "segments": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "size": {
      "description": "exact: a byte count is known. annotated: a hex byte count followed by qualifying evidence. bounded: a lower or upper bound is recorded. variable / unknown / logical: no native byte width applies. 'bytes' carries the leading numeric token for exact, annotated, and bounded values and is absent otherwise; only an exact size is a layout extent.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "raw"],
      "properties": {
        "kind": {"enum": ["exact", "annotated", "bounded", "variable", "unknown", "logical"]},
        "raw": {"type": ["string", "integer"]},
        "bytes": {"type": "integer", "minimum": 0},
        "bound": {"enum": ["at-least", "approximately", "minimum", "maximum"]}
      }
    },
    "offset": {
      "description": "exact: a byte offset from the containing type's base. element-relative: measured inside a nested element type. variable: depends on a preceding variable-length member. none: the record has no in-memory layout.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "raw"],
      "properties": {
        "kind": {"enum": ["exact", "element-relative", "variable", "none"]},
        "raw": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": {"enum": ["unknown", "exact"]},
        "bytes": {"type": "integer", "minimum": 1},
        "reason": {"type": "string", "minLength": 1},
        "source": {"enum": ["overlay"]}
      }
    },
    "deferredDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "owner"],
      "properties": {
        "status": {"const": "deferred"},
        "owner": {"type": "string", "pattern": "^C\\d[a-z]?$"}
      }
    },
    "member": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "offset", "size", "type"],
          "properties": {
            "kind": {"const": "field"},
            "name": {"type": "string", "minLength": 1},
            "offset": {"$ref": "#/$defs/offset"},
            "size": {"$ref": "#/$defs/size"},
            "type": {"type": "string", "minLength": 1},
            "absoluteOffset": {"type": "string", "minLength": 1},
            "citations": {"type": "array", "items": {"$ref": "#/$defs/citationId"}},
            "notes": {"type": "string"},
            "evidence": {"type": "string"}
          }
        },
        {
          "description": "A byte run inside a type of known size that no field covers. Derived from the recorded offsets and sizes; it asserts the absence of a claim, never a new one.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "offset", "size", "annotation"],
          "properties": {
            "kind": {"const": "unknown-span"},
            "offset": {"$ref": "#/$defs/offset"},
            "size": {"$ref": "#/$defs/size"},
            "annotation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": {
                "kind": {"enum": ["unmapped", "padding", "reserved"]},
                "note": {"type": "string", "minLength": 1},
                "source": {"enum": ["overlay"]}
              }
            }
          }
        }
      ]
    },
    "layout": {
      "description": "modeled: the type declares an exact size, every field has an exact width, and every byte is accounted for as a field or an unknown span. partial: either the declared size is not an exact byte count, or some field starts at a known offset with no derivable width; spans are then derived only up to that point and everything past it is unbounded. unmodeled: no member carries an exact offset.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "coveredBytes", "unknownBytes", "overlapBytes"],
      "properties": {
        "status": {"enum": ["modeled", "partial", "unmodeled"]},
        "declaredBytes": {"type": "integer", "minimum": 0},
        "coveredBytes": {"type": "integer", "minimum": 0},
        "unknownBytes": {"type": "integer", "minimum": 0},
        "overlapBytes": {"type": "integer", "minimum": 0},
        "trailing": {"enum": ["unbounded"]}
      }
    },
    "type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "namespace", "confidence", "size", "alignment", "bases", "vtable", "layout", "members", "citations"],
      "properties": {
        "id": {"$ref": "#/$defs/bcsSId"},
        "name": {"type": "string", "minLength": 1},
        "namespace": {"$ref": "#/$defs/namespace"},
        "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "confidence": {"type": "string", "minLength": 1},
        "size": {"$ref": "#/$defs/size"},
        "alignment": {"$ref": "#/$defs/alignment"},
        "bases": {"$ref": "#/$defs/deferredDimension"},
        "vtable": {"$ref": "#/$defs/deferredDimension"},
        "layout": {"$ref": "#/$defs/layout"},
        "members": {"type": "array", "items": {"$ref": "#/$defs/member"}},
        "citations": {"type": "array", "items": {"$ref": "#/$defs/citationId"}},
        "needsReverify": {"const": true},
        "reverifyMethod": {"description": "Verify that the retail 1.23b client accepts the behavior in a live session.", "const": "live-validation against the retail 1.23b client in a live session"},
        "notes": {"type": "string"}
      },
      "dependentRequired": {"needsReverify": ["reverifyMethod"], "reverifyMethod": ["needsReverify"]}
    },
    "address": {
      "description": "scalar: one canonical VA. multi: a function pair or sibling cluster with more than one equally-canonical VA. range: a contiguous VA span. placeholder: 0x00000000, used by phase-summary entries with no VA of their own. Values are recorded verbatim and are never shifted by the IR builder; docs/ir-schema.md defines the source-promotion convention.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "raw", "values"],
      "properties": {
        "kind": {"enum": ["scalar", "multi", "range", "placeholder"]},
        "raw": {"type": "string", "minLength": 1},
        "values": {"type": "array", "items": {"type": "string", "pattern": "^0x[0-9a-fA-F]{8}$"}}
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "address", "addressCorroboration", "confidence", "citations"],
      "properties": {
        "id": {"$ref": "#/$defs/bcsYId"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "address": {"$ref": "#/$defs/address"},
        "addressCorroboration": {
          "description": "Whether the recorded VA appears as a vftable VA in manifests/rtti_vftable_index.json, the tracked reduction of the local RTTI extraction. Descriptive only; it does not feed confidence. 'absent' is expected for COL and TypeDescriptor VAs because the extraction does not index them.",
          "enum": ["matches-rtti-extraction", "absent-from-rtti-extraction", "not-applicable"]
        },
        "confidence": {"type": "string", "minLength": 1},
        "citations": {"type": "array", "items": {"$ref": "#/$defs/citationId"}},
        "needsReverify": {"const": true},
        "reverifyMethod": {"description": "Verify that the retail 1.23b client accepts the behavior in a live session.", "const": "live-validation against the retail 1.23b client in a live session"},
        "notes": {"type": "string"}
      },
      "dependentRequired": {"needsReverify": ["reverifyMethod"], "reverifyMethod": ["needsReverify"]}
    },
    "opcodeId": {
      "description": "Direction-qualified opcode key, 's2c:0x00ca' or 'c2s:0x00ca'. Direction is part of the key because the same hex value can occur in both directions.",
      "type": "string",
      "pattern": "^(s2c|c2s):0x[0-9a-f]{4}$"
    },
    "relationships": {
      "description": "Maps receiver and operation opcode edges and Lua names. Edges are copied from source catalogs, not inferred by name matching. The opcode set is the union of all sources, including bridge entries absent from the coverage matrix.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "summary", "opcodes", "receivers", "operations", "luaBindings"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "path"],
            "properties": {
              "role": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1}
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["opcodes", "s2c", "c2s", "withMatrixRow", "withReceiver", "withOperation", "withLuaBinding", "withSymbol", "nameConflicts", "receivers", "operations", "luaBindings"],
          "properties": {
            "opcodes": {"type": "integer", "minimum": 0},
            "s2c": {"type": "integer", "minimum": 0},
            "c2s": {"type": "integer", "minimum": 0},
            "withMatrixRow": {"type": "integer", "minimum": 0},
            "withReceiver": {"type": "integer", "minimum": 0},
            "withOperation": {"type": "integer", "minimum": 0},
            "withLuaBinding": {"type": "integer", "minimum": 0},
            "withSymbol": {"type": "integer", "minimum": 0},
            "nameConflicts": {
              "description": "Opcodes whose sources disagree on the name. Conflicts are recorded rather than resolved; collapsing them would choose a winner.",
              "type": "integer", "minimum": 0
            },
            "receivers": {"type": "integer", "minimum": 0},
            "operations": {"type": "integer", "minimum": 0},
            "luaBindings": {"type": "integer", "minimum": 0}
          }
        },
        "opcodes": {"type": "array", "items": {"$ref": "#/$defs/opcode"}},
        "receivers": {"type": "array", "items": {"$ref": "#/$defs/receiver"}},
        "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
        "luaBindings": {"type": "array", "items": {"$ref": "#/$defs/luaBinding"}}
      }
    },
    "opcode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "direction", "hex", "int", "names", "receivers", "operations", "luaBindings", "symbols", "sources"],
      "properties": {
        "id": {"$ref": "#/$defs/opcodeId"},
        "direction": {"enum": ["s2c", "c2s"]},
        "hex": {"type": "string", "pattern": "^0x[0-9a-f]{4}$"},
        "int": {"type": "integer", "minimum": 0},
        "names": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "source"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1}
            }
          }
        },
        "matrix": {
          "description": "Present only for an opcode the coverage matrix has a row for.",
          "type": "object",
          "additionalProperties": false,
          "required": ["pattern", "catalogStatus", "pcapCount"],
          "properties": {
            "pattern": {"type": "string", "minLength": 1},
            "catalogStatus": {"type": "string", "minLength": 1},
            "pcapCount": {"type": "integer", "minimum": 0},
            "receiverNames": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "receivers": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "operations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "luaBindings": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "c2sBindings": {
          "description": "Confirmed bindings from the c2s bridge skeleton, using qualified 'Class._method' names. Kept separate from bare Lua bridge names; matching the namespaces would be inference.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["luaApi"],
            "properties": {
              "luaApi": {"type": "string", "minLength": 1},
              "symbols": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bcsYId"}}
            }
          }
        },
        "symbols": {"type": "array", "items": {"$ref": "#/$defs/bcsYId"}},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "receiver": {
      "description": "Identity is (name, vftable address), not name alone: UserDataReceiver has separate 6-slot and 2-slot rows that share a slot1 function. Field-write-only receivers carry no namespace or confidence when the source catalog supplies neither.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "classification", "symbolsByRole", "opcodes", "sources"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "rttiAddress": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "classification": {"enum": ["inbound", "client-internal", "field-write-only"]},
        "confidence": {"type": "string", "minLength": 1},
        "needsReverify": {"const": true},
        "reverifyMethod": {"description": "Verify that the retail 1.23b client accepts the behavior in a live session.", "const": "live-validation against the retail 1.23b client in a live session"},
        "symbolsByRole": {
          "description": "Every bcsRefs group the receiver map states, keyed by its role (class, slot1, ctor, dtor, apply, dispatchWrapper, other).",
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9]*$": {
              "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bcsYId"}
            }
          }
        },
        "slot1Address": {"type": "string", "minLength": 1},
        "dispatchKind": {"type": "string", "minLength": 1},
        "casts": {
          "description": "Cast evidence, normalized from the two spellings the source catalogs use: the receiver map records {src, target} with an optional list of further casts, the field-write catalog records a bare target with no source type.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target"],
            "properties": {
              "src": {"type": "string", "minLength": 1},
              "target": {"type": "string", "minLength": 1}
            }
          }
        },
        "luaCallback": {"type": "string", "minLength": 1},
        "workerAddresses": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "opcodes": {"type": "array", "items": {"$ref": "#/$defs/opcodeId"}},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "dependentRequired": {"needsReverify": ["reverifyMethod"], "reverifyMethod": ["needsReverify"]}
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retailClass", "tail", "symbols", "opcodes", "sources"],
      "properties": {
        "retailClass": {"type": "string", "minLength": 1},
        "tail": {"type": "string", "minLength": 1},
        "symbols": {"type": "array", "items": {"$ref": "#/$defs/bcsYId"}},
        "opcodes": {
          "description": "Confidence rides the edge rather than the opcode, because the source states it per operation-opcode pair.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "confidence"],
            "properties": {
              "id": {"$ref": "#/$defs/opcodeId"},
              "confidence": {"type": "string", "minLength": 1}
            }
          }
        },
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "luaBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["luaName", "symbols", "opcodes", "receivers"],
      "properties": {
        "luaName": {"type": "string", "minLength": 1},
        "symbols": {"type": "array", "items": {"$ref": "#/$defs/bcsYId"}},
        "opcodes": {"type": "array", "items": {"$ref": "#/$defs/opcodeId"}},
        "receivers": {
          "description": "Receiver classes this Lua name was observed dispatching to, each with the vtable slot the observation names.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["receiverClass"],
            "properties": {
              "receiverClass": {"type": "string", "minLength": 1},
              "namespace": {"type": "string", "minLength": 1},
              "slot": {"type": "integer", "minimum": 0},
              "confidence": {"type": "string", "minLength": 1}
            }
          }
        },
        "applyChainBindings": {"type": "integer", "minimum": 1},
        "indirectBindings": {"type": "integer", "minimum": 1}
      }
    },
    "citation": {
      "description": "One distinct sourceRef string, parsed and reverse-indexed; tools/hygiene_scan.py assigns its category vocabulary.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "raw", "category", "resolution", "referencedBy"],
      "properties": {
        "id": {"$ref": "#/$defs/citationId"},
        "raw": {"type": "string", "minLength": 1},
        "category": {"enum": ["citation", "record_label", "repo_relative", "missing_repo_relative", "live_parent_path", "absolute"]},
        "resolution": {
          "description": "external-immutable: a first-party sibling repository citation (repo:path), validated by shape and not checked against this checkout; byte identity, where recorded, lives in a provenance record's sha256. maintainer-record: an identifier for a retired or islanded maintainer record, not a path. in-repo-resolved: the target exists here. in-repo-unresolved: the target is absent here and remains a valid, non-failing provenance state.",
          "enum": ["external-immutable", "maintainer-record", "in-repo-resolved", "in-repo-unresolved"]
        },
        "repo": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "path": {"type": "string", "minLength": 1},
        "anchor": {"type": "string", "minLength": 1},
        "referencedBy": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^BCS-[YS]-\\d{4}$"}
        }
      }
    }
  }
}
